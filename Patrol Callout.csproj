<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<RootNamespace>PatrolsCallouts</RootNamespace>
		<AssemblyName>PatrolsCallouts</AssemblyName>
		<Platforms>AnyCPU;x64</Platforms>
		<Version>1.1.1</Version>
		<GtaVDirectory Condition="'$(GtaVDirectory)' == ''">C:\Program Files\Epic Games\GTAV</GtaVDirectory>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="RagePluginHook" Version="1.124.0" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="LSPD First Response">
			<HintPath>$(GtaVDirectory)\plugins\LSPD First Response.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Microsoft.CSharp" />
		<Reference Include="RagePluginHook">
			<HintPath>$(GtaVDirectory)\RAGEPluginHook.exe</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="System.Windows.Forms" />
	</ItemGroup>

	<!-- The repository retains an old nested project for reference. Do not let
	     the SDK's default glob compile its duplicate source and obj files. -->
	<ItemGroup>
		<Compile Remove="Patrol Callout\**\*.cs" />
		<Compile Remove="tests\**\*.cs" />
		<EmbeddedResource Remove="Patrol Callout\**\*" />
		<None Remove="Patrol Callout\**\*" />
	</ItemGroup>

</Project>
